# Copy this file to ".env" for local work. On Render, enter the same names under Environment.
# Keep comments on their own lines (a comment after an empty value is read as the value).

# "development" locally, "production" on Render
FLASK_ENV=development
# Production: long random values, and the two must be different.
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# SQLite is fine locally. Production must use PostgreSQL (Render's disk is wiped on every deploy):
# postgresql://user:password@host:5432/adventure_db
DATABASE_URL=sqlite:///adventure.db

# Production: your website address, e.g. https://unity-adventure.onrender.com (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# ---- payments ----
UPI_ID=
UPI_PAYEE_NAME=Unity Adventure Sports
# true = confirm UPI instantly with no check. Never in production.
UPI_AUTO_CONFIRM=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The same secret you type in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=
# true = ANYONE gets a free ticket. Local testing only; ignored when FLASK_ENV=production.
ALLOW_DEMO_PAYMENTS=false
HOLD_MINUTES=30
HOLD_MAX_MINUTES=180
BOOKING_CUTOFF_MINUTES=60

# ---- admin account created by seed.py (required when FLASK_ENV=production) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- ticket emails (optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Unity Adventure Sports <your-email@gmail.com>

GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
WEATHER_API_KEY=
WHATSAPP_TOKEN=
